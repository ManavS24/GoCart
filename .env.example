# Currency symbol shown throughout the storefront (client-side).
NEXT_PUBLIC_CURRENCY_SYMBOL='$'

# Comma-separated list of emails allowed into /admin.
# Matched case-insensitively against the user's primary Clerk email.
ADMIN_EMAIL=admin@example.com

# Neon Postgres, pooled connection (used by the app at runtime).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Neon Postgres, direct connection (used by `prisma migrate`).
DIRECT_URL=postgresql://user:password@host/db?sslmode=require

# Clerk — authentication, and the "plus" billing plan used by <Protect>.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Stripe — checkout sessions and the /api/stripe webhook.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ImageKit — store logo and product image uploads.
IMAGEKIT_PUBLIC_KEY=public_xxx
IMAGEKIT_PRIVATE_KEY=private_xxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Inngest — Clerk user sync and scheduled coupon expiry.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# OpenAI-compatible endpoint for AI product descriptions (optional).
# Without these, /api/store/ai fails but the rest of the app works.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
