{
  "name": "gocart",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "start": "next start",
    "lint": "eslint .",
    "check": "node scripts/check-env.mjs",
    "seed": "prisma db seed",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit_tests.test.js",
    "test:integration": "vitest run tests/integration_tests.test.js",
    "test:watch": "vitest",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.31.4",
    "@neondatabase/serverless": "^1.0.1",
    "@prisma/adapter-neon": "^6.14.0",
    "@prisma/client": "^6.14.0",
    "@reduxjs/toolkit": "^2.8.2",
    "axios": "^1.11.0",
    "date-fns": "^4.1.0",
    "imagekit": "^6.0.0",
    "inngest": "^3.40.1",
    "lucide-react": "^0.525.0",
    "next": "^15.5.23",
    "openai": "^5.19.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.5.2",
    "react-redux": "^9.2.0",
    "recharts": "^3.1.2",
    "stripe": "^22.4.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.3.5",
    "jsdom": "^29.1.1",
    "prisma": "^6.14.0",
    "tailwindcss": "^4",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "^0.35.3",
    "uuid": "^11.1.1"
  }
